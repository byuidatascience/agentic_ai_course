    "#| echo: false\n",
    "#| eval: true\n",
    "#| output: asis\n",
    "\n",
    "import re\n",
    "import html\n",
    "from pathlib import Path\n",
    "from datetime import date, timedelta\n",
    "\n",
    "FIRST_MEETING = date(2026, 9, 14)  # Mon — course_design/syllabus.md: Fall 2026, MWF\n",
    "\n",
    "\n",
    "def read_var(name, path=Path(\"_variables.yml\")):\n",
    "    try:\n",
    "        text = path.read_text(encoding=\"utf-8\")\n",
    "    except OSError:\n",
    "        return \"\"\n",
    "    m = re.search(rf'^{re.escape(name)}:\\s*\"(.*?)\"\\s*$', text, re.MULTILINE)\n",
    "    return m.group(1) if m else \"\"\n",
    "\n",
    "\n",
    "NOTEBOOK_BASE = read_var(\"notebook_base\")\n",
    "NOTEBOOK_HOVER = read_var(\"example_hover\") or \"Opens in Google Colab\"\n",
    "\n",
    "LESSON_EMOJI = \"📖\"\n",
    "PREP_EMOJI = \"🌱\"\n",
    "SLIDES_EMOJI = \"🧑‍🏫\"\n",
    "NOTEBOOK_EMOJI = \"📓\"\n",
    "PRACTICE_EMOJI = \"🏃‍♂️‍➡️\"\n",
    "\n",
    "FRONTMATTER_RE = re.compile(r\"^---\\s*\\n(.*?)\\n---\", re.DOTALL)\n",
    "TITLE_RE = re.compile(r'^title:\\s*\"?(.*?)\"?\\s*$', re.MULTILINE)\n",
    "\n",
    "\n",
    "def get_title(path: Path, fallback: str) -> str:\n",
    "    try:\n",
    "        text = path.read_text(encoding=\"utf-8\")\n",
    "    except OSError:\n",
    "        return fallback\n",
    "    fm = FRONTMATTER_RE.match(text)\n",
    "    if not fm:\n",
    "        return fallback\n",
    "    m = TITLE_RE.search(fm.group(1))\n",
    "    if not m:\n",
    "        return fallback\n",
    "    title = m.group(1).strip().replace('\\\\\"', '\"')\n",
    "    return title or fallback\n",
    "\n",
    "\n",
    "def exists_nonempty(p: Path) -> bool:\n",
    "    return p.is_file() and p.stat().st_size > 0\n",
    "\n",
    "\n",
    "def collect(folder: str, type_name: str, ext: str):\n",
    "    \"\"\"Map (unit, day) -> list of (suffix_or_None, path) for every matching,\n",
    "    non-empty file. Accepts an optional trailing _<suffix> so a day can have\n",
    "    more than one file of the same kind (e.g. notebook1_1_example.ipynb).\"\"\"\n",
    "    pattern = re.compile(rf\"^{type_name}(\\d+)_(\\d+)(?:_([A-Za-z0-9-]+))?\\.{ext}$\")\n",
    "    out = {}\n",
    "    d = Path(folder)\n",
    "    if not d.is_dir():\n",
    "        return out\n",
    "    for p in sorted(d.glob(f\"*.{ext}\")):\n",
    "        m = pattern.match(p.name)\n",
    "        if not m or not exists_nonempty(p):\n",
    "            continue\n",
    "        unit, day, suffix = int(m.group(1)), int(m.group(2)), m.group(3)\n",
    "        out.setdefault((unit, day), []).append((suffix, p))\n",
    "    for items in out.values():\n",
    "        items.sort(key=lambda t: (t[0] is not None, t[0] or \"\"))\n",
    "    return out\n",
    "\n",
    "\n",
    "lessons = collect(\"lessons\", \"lesson\", \"qmd\")\n",
    "preps = collect(\"preps\", \"prep\", \"qmd\")\n",
    "slides = collect(\"lecture_slides\", \"slide\", \"qmd\")\n",
    "notebooks = collect(\"notebooks\", \"notebook\", \"ipynb\")\n",
    "practice = collect(\"practice\", \"practice\", \"qmd\")\n",
    "for key, items in collect(\"practice\", \"practice\", \"ipynb\").items():\n",
    "    practice.setdefault(key, []).extend(items)\n",
    "for items in practice.values():\n",
    "    items.sort(key=lambda t: (t[0] is not None, t[0] or \"\"))\n",
    "\n",
    "row_keys = sorted(set(lessons) | set(preps) | set(slides) | set(notebooks) | set(practice))\n",
    "\n",
    "\n",
    "def mwf_dates(start: date, count: int):\n",
    "    d, out = start, []\n",
    "    while len(out) < count:\n",
    "        if d.weekday() in (0, 2, 4):  # Mon, Wed, Fri\n",
    "            out.append(d)\n",
    "        d += timedelta(days=1)\n",
    "    return out\n",
    "\n",
    "\n",
    "today = date.today()\n",
    "computed_dates = mwf_dates(FIRST_MEETING, len(row_keys))\n",
    "future_idx = next((i for i, dd in enumerate(computed_dates) if dd > today), None)\n",
    "\n",
    "\n",
    "def date_cell(i: int, d: date) -> str:\n",
    "    if d <= today or i == future_idx:\n",
    "        return f\"{d.strftime('%b')} {d.day}, {d.year}\"\n",
    "    return \"TBD\"\n",
    "\n",
    "\n",
    "def label_for(emoji: str, suffix, noun: str) -> str:\n",
    "    if suffix is None:\n",
    "        return emoji\n",
    "    extra = suffix.replace(\"_\", \" \").replace(\"-\", \" \").title()\n",
    "    return f\"{emoji} {html.escape(extra)}\"\n",
    "\n",
    "\n",
    "def local_link_cell(items, emoji: str, noun: str, html_dir: str) -> str:\n",
    "    if not items:\n",
    "        return \"\"\n",
    "    cells = []\n",
    "    for suffix, path in items:\n",
    "        href = f\"{html_dir}/{path.stem}.html\"\n",
    "        title_attr = \"\" if suffix is None else f' title=\"{html.escape(noun)}: {html.escape(suffix)}\"'\n",
    "        cells.append(f'<a href=\"{html.escape(href)}\"{title_attr}>{label_for(emoji, suffix, noun)}</a>')\n",
    "    return \" \".join(cells)\n",
    "\n",
    "\n",
    "def notebook_link_cell(items) -> str:\n",
    "    if not items:\n",
    "        return \"\"\n",
    "    cells = []\n",
    "    for suffix, path in items:\n",
    "        label = label_for(NOTEBOOK_EMOJI, suffix, \"Notebook\")\n",
    "        if NOTEBOOK_BASE:\n",
    "            tail = path.stem[len(\"notebook\"):]  # e.g. \"1_1\" or \"1_1_example\"\n",
    "            href = f\"{NOTEBOOK_BASE}{tail}.ipynb\"\n",
    "            cells.append(\n",
    "                f'<a href=\"{html.escape(href)}\" title=\"{html.escape(NOTEBOOK_HOVER)}\" target=\"_blank\">'\n",
    "                f\"{label}</a>\"\n",
    "            )\n",
    "        else:\n",
    "            cells.append(label)\n",
    "    return \" \".join(cells)\n",
    "\n",
    "\n",
    "def unit_label(u: int) -> str:\n",
    "    p = Path(\"lessons\") / f\"unit{u}.qmd\"\n",
    "    if exists_nonempty(p):\n",
    "        return f'<a href=\"lessons/unit{u}.html\">Unit {u}</a>'\n",
    "    return f\"Unit {u}\"\n",
    "\n",
    "\n",
    "rows = []\n",
    "for (u, d) in row_keys:\n",
    "    lesson_items = lessons.get((u, d), [])\n",
    "    if lesson_items:\n",
    "        _, lesson_path = lesson_items[0]\n",
    "        topic_cell = html.escape(get_title(lesson_path, f\"Day {u}.{d}\"))\n",
    "        lesson_cell = f'<a href=\"lessons/{lesson_path.stem}.html\" title=\"Lesson\">{LESSON_EMOJI}</a>'\n",
    "    else:\n",
    "        topic_cell = f\"Day {u}.{d}\"\n",
    "        lesson_cell = \"\"\n",
    "\n",
    "    rows.append({\n",
    "        \"unit\": u,\n",
    "        \"topic\": topic_cell,\n",
    "        \"lesson\": lesson_cell,\n",
    "        \"prep\": local_link_cell(preps.get((u, d), []), PREP_EMOJI, \"Prep\", \"preps\"),\n",
    "        \"slides\": local_link_cell(slides.get((u, d), []), SLIDES_EMOJI, \"Slides\", \"lecture_slides\"),\n",
    "        \"notebook\": notebook_link_cell(notebooks.get((u, d), [])),\n",
    "        \"practice\": local_link_cell(practice.get((u, d), []), PRACTICE_EMOJI, \"Practice\", \"practice\"),\n",
    "    })\n",
    "\n",
    "for i, r in enumerate(rows):\n",
    "    r[\"date\"] = date_cell(i, computed_dates[i])\n",
    "\n",
    "if not rows:\n",
    "    print(\"_No lessons published yet — check back soon._\")\n",
    "else:\n",
    "    body = []\n",
    "    i, n = 0, len(rows)\n",
    "    while i < n:\n",
    "        u = rows[i][\"unit\"]\n",
    "        span = 1\n",
    "        while i + span < n and rows[i + span][\"unit\"] == u:\n",
    "            span += 1\n",
    "        unit_html = unit_label(u)\n",
    "        for j in range(span):\n",
    "            r = rows[i + j]\n",
    "            unit_td = f'<td rowspan=\"{span}\">{unit_html}</td>' if j == 0 else \"\"\n",
    "            body.append(\n",
    "                f'<tr>{unit_td}<td>{r[\"date\"]}</td><td>{r[\"topic\"]}</td><td>{r[\"lesson\"]}</td>'\n",
    "                f'<td>{r[\"prep\"]}</td><td>{r[\"slides\"]}</td>'\n",
    "                f'<td>{r[\"notebook\"]}</td><td>{r[\"practice\"]}</td></tr>'\n",
    "            )\n",
    "        i += span\n",
    "\n",
    "    table = [\n",
    "        '<table class=\"schedule\">',\n",
    "        \"<thead><tr><th>Unit</th><th>Date</th><th>Topic</th><th>Lesson</th>\"\n",
    "        \"<th>Prep</th><th>Slides</th><th>Notebooks</th><th>Practice</th></tr></thead>\",\n",
    "        \"<tbody>\",\n",
    "        *body,\n",
    "        \"</tbody>\",\n",
    "        \"</table>\",\n",
    "    ]\n",
    "    print(\"\\n\".join(table))"
   ]
